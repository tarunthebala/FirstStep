# ── Server
PORT=3000
# Public URL of the app (used in auth redirect links; https enables Secure cookies + HSTS)
APP_URL=http://localhost:3000
NODE_ENV=development
# Set true on hosts that put a proxy in front of the app (Render, Railway, Fly, Heroku, nginx)
# so login/sign-up/demo rate limits apply per visitor instead of to everyone at once.
TRUST_PROXY=false

# ── Data driver: "local" (JSON file, development) or "supabase" (production)
DATA_DRIVER=local
LOCAL_DATA_FILE=.data/firststep.json

# ── Supabase (required when DATA_DRIVER=supabase)
SUPABASE_URL=
# Public anon key — sent with each user's JWT; Row Level Security enforces ownership.
SUPABASE_ANON_KEY=
# Server-only. Used ONLY for the connection_secrets table and for deleting auth users. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Encryption for provider access tokens at rest (required in production)
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── Plaid (optional; without it the app runs with manual entry)
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Offer "Connect Loan Servicer" (Plaid Liabilities). Only set true after confirming with Plaid that your
# account has Liabilities and that your users' servicers are supported.
PLAID_ENABLE_LIABILITIES=false
# Needed for OAuth institutions in production
PLAID_REDIRECT_URI=

# ── Email reminders (reserved; no provider is wired in this build, so email opt-in stays disabled)
EMAIL_PROVIDER=

# ── Demo mode ("false" hides the fictional-data demo)
DEMO_MODE=true
